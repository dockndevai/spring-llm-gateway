<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.llmgw</groupId>
    <artifactId>spring-llm-gateway-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>spring-llm-gateway-sample</artifactId>
  <name>spring-llm-gateway-sample</name>
  <description>Runnable LLM gateway wired to vLLM and Ollama</description>

  <dependencies>
    <!--
      The one dependency. It brings spring-cloud-starter-gateway-server-webflux with it, so a
      standalone app needs nothing else to be a gateway.
    -->
    <dependency>
      <groupId>io.github.llmgw</groupId>
      <artifactId>spring-llm-gateway-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Failover. Optional in core, so a consumer opts in explicitly. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
    </dependency>

    <!-- Cross-instance token quotas (llm.gateway.quota.backend=redis). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
    </dependency>

    <!-- Keycloak virtual keys (llm.gateway.auth.mode=jwt), used by the "jwt" profile. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Metrics: /actuator/prometheus exposes the llm.* meters. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
